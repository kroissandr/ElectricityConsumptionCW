{# templates/energy/add.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Добавить данные - Система оценки трат электроэнергии{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Добавить запись о потреблении</h4>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.area) }}
                            {{ form_widget(form.area, {'attr': {'class': 'form-control'}}) }}
                            <div class="form-text">Площадь жилого помещения в квадратных метрах</div>
                            {% if form.area.vars.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form_errors(form.area) }}
                                </div>
                            {% endif %}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.residents) }}
                            {{ form_widget(form.residents, {'attr': {'class': 'form-control'}}) }}
                            <div class="form-text">Количество человек, проживающих в помещении</div>
                            {% if form.residents.vars.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form_errors(form.residents) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.season) }}
                            {{ form_widget(form.season, {'attr': {'class': 'form-select'}}) }}
                            <div class="form-text">Сезон, для которого указаны данные</div>
                            {% if form.season.vars.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form_errors(form.season) }}
                                </div>
                            {% endif %}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.temperature) }}
                            {{ form_widget(form.temperature, {'attr': {'class': 'form-control'}}) }}
                            <div class="form-text">Средняя температура воздуха в градусах Цельсия</div>
                            {% if form.temperature.vars.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form_errors(form.temperature) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.consumption) }}
                        {{ form_widget(form.consumption, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-text">Фактическое потребление электроэнергии в киловатт-часах</div>
                        {% if form.consumption.vars.errors %}
                            <div class="invalid-feedback d-block">
                                {{ form_errors(form.consumption) }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.notes) }}
                        {{ form_widget(form.notes, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                        <div class="form-text">Дополнительная информация (необязательно)</div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-circle"></i> Сохранить запись
                        </button>
                        <a href="{{ path('energy_history') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Вернуться к истории
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
